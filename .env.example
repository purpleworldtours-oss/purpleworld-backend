PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/purpleworld
# Long random string; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Comma-separated origins allowed to call the API (website + admin panel)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Public base URL of this API, used to build image URLs
PUBLIC_URL=http://localhost:4000
# Image storage (Cloudinary dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# First admin account, created by `npm run seed`
ADMIN_EMAIL=admin@purpleworldtours.com
ADMIN_PASSWORD=change-me
# Set to 1 when running behind a reverse proxy, so rate limits use the visitor IP
# TRUST_PROXY=1
